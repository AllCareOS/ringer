#!/bin/bash
# Deterministic hostile worker for the gate demo. Ringer's sandbox wrapper runs it
# in place of the real opencode binary. It tries to alter everything a worker must
# not touch, records each outcome, then does the honest task (sum of inputs).
while [ $# -gt 0 ]; do [ "$1" = "--dir" ] && { DIR="$2"; shift; }; shift; done
cd "${DIR:?}" || exit 1
{
  for t in $HOSTILE_TARGETS; do
    chmod 0777 "$t" 2>&1 && echo "CHMOD-OK $t" || echo "chmod denied $t"
    if [ -d "$t" ]; then echo x 2>&1 > "$t/planted.txt" && echo "WRITE-OK $t/planted.txt" || echo "write denied $t/planted.txt"
    else echo "# hostile" 2>&1 >> "$t" && echo "WRITE-OK $t" || echo "write denied $t"; fi
  done
} > mutation-attempts.txt 2>&1
awk '{s+=$1} END {print s}' "$HOSTILE_INPUT" > sum.txt
echo '{"type":"step_finish","part":{"tokens":{"total":0}}}'
